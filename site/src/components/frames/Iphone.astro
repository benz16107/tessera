---
// iPhone frame, ported from Magic UI's "iphone" component (https://magicui.design, registry/magicui/iphone.tsx),
// MIT License, Copyright (c) Magic UI. Changes: Astro instead of React, Darkroom colours, a status-bar inset so
// the Dynamic Island sits over a bar instead of over the app's header, and a slot for stacked screens.
// Geometry (viewBox 433 x 882, screen at 21.25, 19.25, 389.5 x 843.5, radius 55.75) is Magic UI's.
interface Props { bar?: string; class?: string }
const { bar = '#f5f5f3', class: cls } = Astro.props;
const id = `ip${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['iphone', cls]} style={`--bar:${bar}`}>
  <div class="iphone-screen">
    <div class="iphone-bar" aria-hidden="true"></div>
    <div class="iphone-content"><slot /></div>
  </div>
  <svg viewBox="0 0 433 882" fill="none" xmlns="http://www.w3.org/2000/svg" class="iphone-svg" aria-hidden="true">
    <defs>
      <mask id={`${id}m`} maskUnits="userSpaceOnUse">
        <rect x="0" y="0" width="433" height="882" fill="white" />
        <rect x="21.25" y="19.25" width="389.5" height="843.5" rx="55.75" ry="55.75" fill="black" />
      </mask>
    </defs>
    <g mask={`url(#${id}m)`}>
      <path d="M2 73C2 32.6832 34.6832 0 75 0H357C397.317 0 430 32.6832 430 73V809C430 849.317 397.317 882 357 882H75C34.6832 882 2 849.317 2 809V73Z" class="edge" />
      <path d="M0 171C0 170.448 0.447715 170 1 170H3V204H1C0.447715 204 0 203.552 0 203V171Z" class="edge" />
      <path d="M1 234C1 233.448 1.44772 233 2 233H3.5V300H2C1.44772 300 1 299.552 1 299V234Z" class="edge" />
      <path d="M1 319C1 318.448 1.44772 318 2 318H3.5V385H2C1.44772 385 1 384.552 1 384V319Z" class="edge" />
      <path d="M430 279H432C432.552 279 433 279.448 433 280V384C433 384.552 432.552 385 432 385H430V279Z" class="edge" />
      <path d="M6 74C6 35.3401 37.3401 4 76 4H356C394.66 4 426 35.3401 426 74V808C426 846.66 394.66 878 356 878H76C37.3401 878 6 846.66 6 808V74Z" class="body" />
    </g>
    <path opacity="0.5" d="M174 5H258V5.5C258 6.60457 257.105 7.5 256 7.5H176C174.895 7.5 174 6.60457 174 5.5V5Z" class="edge" />
    <path d="M154 48.5C154 38.2827 162.283 30 172.5 30H259.5C269.717 30 278 38.2827 278 48.5C278 58.7173 269.717 67 259.5 67H172.5C162.283 67 154 58.7173 154 48.5Z" class="island" />
    <path d="M254 48.5C254 45.4624 256.462 43 259.5 43C262.538 43 265 45.4624 265 48.5C265 51.5376 262.538 54 259.5 54C256.462 54 254 51.5376 254 48.5Z" class="lens" />
  </svg>
</div>

<style>
  .iphone { position: relative; display: block; aspect-ratio: 433 / 882; width: 100%; }
  .iphone-screen { position: absolute; left: 4.907%; top: 2.183%; width: 89.954%; height: 95.635%; border-radius: 14.31% / 6.61%; overflow: hidden; background: var(--bar); display: flex; flex-direction: column; }
  /* About the height of iOS's status bar at this scale; the app's own header starts below it. */
  .iphone-bar { flex: 0 0 6.2%; background: var(--bar); }
  .iphone-content { position: relative; flex: 1; overflow: hidden; }
  .iphone-content :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .iphone-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .edge { fill: #3a3833; }
  .body { fill: #1c1b19; }
  .island, .lens { fill: #0b0b0a; }
  .lens { fill: #22211e; }
</style>
