---
// The bar shared by every page, built like Studio's top bar: the ring wordmark, page tabs, one amber button.
// On docs pages Starlight's search sits in the middle slot.
import { APP_URL } from '../site.ts';
interface Props { current?: 'home' | 'tracks' | 'docs' }
const { current } = Astro.props;
const path = Astro.url.pathname;
const here = current ?? (path.startsWith('/tracks') ? 'tracks' : path.startsWith('/docs') ? 'docs' : 'home');
---
<div class="sm-bar">
  <a class="wordmark" href="/" aria-label="Tessera home">TESSERA</a>
  <slot name="middle" />
  <nav class="sm-nav" aria-label="Site">
    <a href="/tracks/" aria-current={here === 'tracks' ? 'page' : undefined}>Tracks</a>
    <a href="/docs/get-started/" aria-current={here === 'docs' ? 'page' : undefined}>Docs</a>
  </nav>
  <a class="btn primary sm-cta" href={APP_URL}>Open the app</a>
</div>

<style is:global>
  .sm-bar { display: flex; align-items: center; gap: 16px; height: 100%; width: 100%; }
  .sm-nav { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  .sm-nav a { display: inline-flex; align-items: center; height: var(--control-h-dense); padding: 0 12px; border-radius: var(--r); font: 500 var(--t-sm) / 1 var(--sans); color: var(--text-2); text-decoration: none; white-space: nowrap; transition-property: background-color, color; transition-duration: 120ms; transition-timing-function: ease-out; }
  .sm-nav a[aria-current='page'] { background: var(--raise); color: var(--text); }
  @media (hover: hover) and (pointer: fine) { .sm-nav a:hover { color: var(--text); } }
  .sm-cta { flex: none; }
  @media (max-width: 420px) { .sm-bar { gap: 8px; } .sm-nav a { padding: 0 8px; } }
</style>
