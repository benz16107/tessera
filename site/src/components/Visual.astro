---
// One chart, table or diagram on a track page, as plain HTML: no chart library. Every bar carries its value as text,
// "ours" is named in words as well as the warm colour, and every visual ends with its source.
// Colours: ours #c9a46a (the app's --warm), others #7d786f; both pass 3:1 on the panel and CVD separation (dataviz
// validate_palette.js, dark, surface #111110).
import type { Visual } from '../tracks/types.ts';
interface Props { v: Visual }
const { v } = Astro.props;
let width = (_: number) => 0;
if (v.kind === 'bars') {
  const vals = v.rows.map((r) => r.value);
  const max = Math.max(...vals), lo = Math.min(...vals) / 2;
  width = v.log ? (x) => (Math.log10(x / lo) / Math.log10(max / lo)) * 100 : (x) => (x / max) * 100;
}
---
<figure class:list={['viz', `viz-${v.kind}`, { wide: v.kind === 'table' || v.kind === 'flow' || v.kind === 'hub' || (v.kind === 'bars' && v.rows.length > 6) }]}>
  <figcaption class="viz-title">{v.title}</figcaption>
  {v.kind === 'bars' && (
    <ul class="vb">
      {v.rows.map((r) => (
        <li class:list={[{ ours: r.ours }]} title={`${r.label}: ${r.display}`}>
          <span class="vb-label">{r.label}{r.ours && <span class="vb-tag">ours</span>}</span>
          <span class="vb-track" aria-hidden="true"><span class="vb-bar" style={`width:${Math.max(1.5, width(r.value)).toFixed(1)}%`} /></span>
          <span class="vb-value num">{r.display}</span>
        </li>
      ))}
    </ul>
  )}
  {v.kind === 'stats' && <dl class="vs">{v.items.map((s) => <div><dt class="num">{s.value}</dt><dd>{s.label}</dd></div>)}</dl>}
  {v.kind === 'table' && (
    <div class="vt"><table>
      <thead><tr>{v.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{v.rows.map((row) => <tr>{row.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
    </table></div>
  )}
  {v.kind === 'flow' && (
    <ol class="vf">{v.steps.map((s) => <li><strong>{s.label}</strong>{s.detail && <span>{s.detail}</span>}</li>)}</ol>
  )}
  {v.kind === 'hub' && (
    <div class="vh">
      <p class="vh-center">{v.center}</p>
      <ul>{v.spokes.map((s) => <li><strong>{s.label}</strong>{s.detail && <span>{s.detail}</span>}</li>)}</ul>
    </div>
  )}
  {v.note && <p class="viz-note">{v.note}</p>}
  <p class="viz-source">Source: {v.source}</p>
</figure>

<style>
  .viz { margin: 0; padding: 20px; border-radius: var(--r-panel); background: var(--panel); box-shadow: 0 0 0 1px var(--line); min-width: 0; }
  .viz.wide { grid-column: 1 / -1; }
  .viz-title { margin: 0 0 16px; font-size: var(--t-md); font-weight: 600; color: var(--text); text-wrap: balance; }
  .viz-note { margin: 12px 0 0; font-size: var(--t-sm); color: var(--text-2); }
  .viz-source { margin: 12px 0 0; font-size: var(--t-xs); color: var(--text-3); line-height: 1.5; overflow-wrap: anywhere; }

  .vb { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .vb li { display: grid; grid-template-columns: minmax(96px, 38%) minmax(0, 1fr) auto; align-items: center; gap: 12px; font-size: var(--t-sm); }
  .vb-label { color: var(--text-2); line-height: 1.3; }
  .vb-tag { margin-left: 6px; padding: 1px 6px; border-radius: var(--r); font-size: var(--t-xs); color: var(--text); box-shadow: inset 0 0 0 1px #c9a46a; }
  .vb-track { position: relative; height: 12px; }
  .vb-bar { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 0 4px 4px 0; background: #7d786f; }
  .ours .vb-bar { background: #c9a46a; }
  .ours .vb-label { color: var(--text); font-weight: 600; }
  .vb-value { color: var(--text); white-space: nowrap; text-align: right; min-width: 6ch; }

  .vs { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; }
  .vs div { border-top: 1px solid var(--line-2); padding-top: 12px; }
  .vs dt { font-size: var(--t-xl); line-height: 1.1; color: var(--text); }
  .vs dd { margin: 6px 0 0; font-size: var(--t-sm); color: var(--text-2); line-height: 1.45; }

  .vt { overflow-x: auto; }
  .vt table { width: 100%; border-collapse: collapse; font-size: var(--t-sm); line-height: 1.45; }
  .vt th, .vt td { text-align: left; vertical-align: top; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .vt thead th { color: var(--text-3); font-weight: 500; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.06em; }
  .vt tbody th { color: var(--text); font-weight: 600; }
  .vt td { color: var(--text-2); }

  .vf { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; counter-reset: step; }
  .vf li { position: relative; flex: 1 1 150px; display: flex; flex-direction: column; gap: 4px; padding: 12px; border-radius: var(--r); background: var(--raise); font-size: var(--t-sm); counter-increment: step; }
  .vf li::before { content: counter(step); font-size: var(--t-xs); color: var(--text-3); }
  .vf strong { color: var(--text); font-weight: 600; }
  .vf span { color: var(--text-2); }

  .vh { display: grid; gap: 12px; }
  .vh-center { margin: 0; padding: 12px 16px; border-radius: var(--r); box-shadow: inset 0 0 0 1px #c9a46a; color: var(--text); font-weight: 600; text-align: center; }
  .vh ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; }
  .vh li { display: flex; flex-direction: column; gap: 4px; padding: 12px; border-radius: var(--r); background: var(--raise); font-size: var(--t-sm); }
  .vh strong { color: var(--text); }
  .vh span { color: var(--text-2); }
  @media (max-width: 520px) { .vb li { grid-template-columns: minmax(0, 1fr) auto; } .vb-track { grid-column: 1 / -1; grid-row: 2; } }
</style>
