---
// One sponsor track, outside the docs: what we built, why the sponsor, every place it runs, proof, ours vs theirs,
// limits and the video. Content lives in src/tracks/<slug>.ts; this file is only layout.
import { Image } from 'astro:assets';
import Landing from '../../layouts/Landing.astro';
import Browser from '../../components/frames/Browser.astro';
import Iphone from '../../components/frames/Iphone.astro';
import ThreadMock from '../../components/ThreadMock.astro';
import { TRACKS } from '../../tracks/index.ts';
import type { Track, Status } from '../../tracks/types.ts';

export function getStaticPaths() {
  return TRACKS.map((t, i) => ({ params: { slug: t.slug }, props: { t, prev: TRACKS[i - 1], next: TRACKS[i + 1] } }));
}
interface Props { t: Track; prev?: Track; next?: Track }
const { t, prev, next } = Astro.props;
const STATUS: Record<Status, string> = { live: 'Live', built: 'Built', 'stand-in': 'Stand-in proof', blocked: 'Blocked' };
const sections = [['why', t.whyTitle ?? `Why ${t.sponsor}`], ...(t.threads ? [['threads', 'The threads']] : []), ['where', "Where it's used"], ['proof', 'Proof'], ['split', 'Ours vs theirs'], ['limits', 'Limits'], ['video', 'Video']];
---
<Landing title={`${t.sponsor} track: Tessera`} description={t.oneLine} current="tracks">
  <article class="tk">
    <header class="tk-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/tracks/">Tracks</a><span aria-hidden="true">/</span>{t.sponsor}</nav>
      <p class="eyebrow">{t.prize}</p>
      <h1>{t.oneLine}</h1>
      {t.note && <p class="tk-note">{t.noteTag && <span class="tag live">{t.noteTag}</span>}{t.note}</p>}
    </header>

    <figure class="tk-hero">
      {t.hero.frame === 'browser' && <Browser url={t.hero.url}><Image src={t.hero.img} alt={t.hero.alt} widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1040px" loading="eager" /></Browser>}
      {t.hero.frame === 'phone' && <div class="hero-phone"><Iphone><Image src={t.hero.img} alt={t.hero.alt} widths={[400, 800]} sizes="320px" loading="eager" /></Iphone></div>}
      {t.hero.frame === 'none' && <Image class="hero-plain" src={t.hero.img} alt={t.hero.alt} widths={[600, 900, 1200]} sizes="(max-width: 700px) 100vw, 640px" loading="eager" />}
      <figcaption>{t.hero.caption}</figcaption>
    </figure>

    <dl class="tk-nums">
      {t.headline.map((p) => (
        <div>
          <dt class="num">{p.value}</dt>
          <dd>{p.label}{p.standIn && <span class="tag stand-in small">stand-in</span>}</dd>
        </div>
      ))}
    </dl>

    <nav class="tk-toc" aria-label="On this page">{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>

    <section id="why" class="tk-sec">
      <h2>{t.whyTitle ?? `Why ${t.sponsor}`}</h2>
      <div class="why-grid">
        {t.why.map((w, i) => (
          <div class="why"><span class="num why-n">0{i + 1}</span><h3>{w.title}</h3><p>{w.body}</p></div>
        ))}
      </div>
    </section>

    {t.threads && (
      <section id="threads" class="tk-sec">
        <h2>The five mechanisms, as they arrive</h2>
        <p class="sub">Each card is one thread in the app it happens in. Cards tagged Live are screenshots of the real bot. Cards tagged Stand-in quote our end-to-end run; grey lines say what happened where the run recorded no exact words. Each stand-in card is replaced as its live round trip is recorded.</p>
        {(() => { const common = t.threads!.find((th) => !th.live)?.source; return <>
          {common && <p class="src-line">Stand-in cards: {common}.</p>}
          <div class="threads">{t.threads!.map((th) => <ThreadMock thread={th} showSource={!!th.live || th.source !== common} />)}</div>
        </>; })()}
      </section>
    )}

    <section id="where" class="tk-sec">
      <h2>Where it's used</h2>
      <p class="sub">{t.uses.length} places in Tessera, each with where it lives in the code.</p>
      <ul class="uses">
        {t.uses.map((u) => (
          <li class:list={['use', { 'has-img': !!u.img }]}>
            {u.img && <Image class="use-img" src={u.img} alt={u.alt ?? u.name} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 360px" />}
            <div class="use-body">
              <div class="use-top"><h3>{u.name}</h3><span class:list={['tag', u.status]}>{STATUS[u.status]}</span></div>
              <p>{u.line}</p>
              <p class="use-where"><code>{u.where}</code></p>
              {u.detail && <details><summary>More</summary><p>{u.detail}</p></details>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="proof" class="tk-sec">
      <h2>Proof</h2>
      <p class="sub">Measured numbers, and exactly how to check each one.</p>
      <ul class="proof">
        {t.proof.map((p) => (
          <li>
            <span class="num proof-v">{p.value}</span>
            <div><p>{p.label}{p.standIn && <span class="tag stand-in small">stand-in</span>}</p><p class="check"><code>{p.check}</code></p></div>
          </li>
        ))}
      </ul>
    </section>

    <section id="split" class="tk-sec">
      <h2>{t.splitTitle ?? `What's ours, what's ${t.sponsor}'s`}</h2>
      <div class="split">
        <div><h3>Tessera built</h3><ul>{t.ours.map((x) => <li>{x}</li>)}</ul></div>
        <div><h3>{t.theirsTitle ?? `${t.sponsor} provides`}</h3><ul>{t.theirs.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section id="limits" class="tk-sec">
      <h2>Known limits</h2>
      <ul class="limits">{t.limits.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section id="video" class="tk-sec">
      <h2>Video</h2>
      {t.video.url
        ? <a class="video-slot has-url" href={t.video.url}>Watch "{t.video.title}" ({t.video.length})</a>
        : <p class="video-row"><strong>{t.video.title}</strong><span class="num">{t.video.length}</span><span>A screen recording of the live app, made after the build. It follows this shot list.</span></p>}
      <details class="shots">
        <summary>Shot list: {t.video.summary}</summary>
        <table>
          <thead><tr><th>Time</th><th>On screen</th><th>Narration</th><th>Shows</th></tr></thead>
          <tbody>{t.video.shots.map((s) => <tr><td class="num">{s.t}</td><td>{s.screen}</td><td>{s.say}</td><td>{s.criterion}</td></tr>)}</tbody>
        </table>
        <p class="rec-notes"><strong>Recording notes.</strong> {t.video.notes}</p>
      </details>
    </section>

    <section class="tk-sec tk-docs">
      <h2>In the docs</h2>
      <ul>{t.docs.map((d) => <li><a href={d.href}>{d.label}</a></li>)}</ul>
    </section>

    <nav class="tk-next" aria-label="Other tracks">
      {prev ? <a href={`/tracks/${prev.slug}/`}><span>Previous</span>{prev.sponsor}</a> : <a href="/tracks/"><span>All tracks</span>Overview</a>}
      {next ? <a class="r" href={`/tracks/${next.slug}/`}><span>Next</span>{next.sponsor}</a> : <a class="r" href="/tracks/"><span>All tracks</span>Overview</a>}
    </nav>
  </article>
</Landing>

<style is:global>
  /* Track pages: Darkroom tokens, one column of short sections, details behind expanders. */
  .tk { max-width: 1088px; margin: 0 auto; padding: 0 24px 96px; }
  @media (max-width: 420px) { .tk { padding-inline: 16px; } }
  .tk h1, .tk h2, .tk h3 { font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; margin: 0; }
  .tk p { text-wrap: pretty; }
  .tk .num { font-family: var(--mono); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .tk code { font-family: var(--mono); font-size: 0.8125em; color: var(--text-2); overflow-wrap: anywhere; }
  .tk-head { padding-top: 64px; max-width: 860px; }
  .crumbs { display: flex; gap: 8px; font: 400 0.75rem/1 var(--mono); color: var(--text-3); }
  .crumbs a { color: var(--text-2); text-decoration: none; }
  .crumbs a:hover { color: var(--text); text-decoration: underline; }
  .eyebrow { margin: 24px 0 0; font: 400 0.75rem/1.4 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--amber); }
  .tk-head h1 { margin-top: 12px; font-size: 2.25rem; line-height: 1.15; }
  .tk-note { margin: 24px 0 0; padding: 12px 16px; border-radius: var(--r); background: var(--panel); box-shadow: 0 0 0 1px var(--line-2); color: var(--text-2); font-size: 0.875rem; line-height: 1.55; }
  .tk-note .tag { margin-right: 8px; }
  .tag { display: inline-block; vertical-align: 0.1em; font: 400 0.625rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 6px; border-radius: 4px; white-space: nowrap; }
  .tag.small { margin-left: 8px; }
  .tag.live { color: #0b0b0a; background: var(--teal); }
  .tag.built { color: var(--text-2); box-shadow: inset 0 0 0 1px var(--line-2); }
  .tag.stand-in { color: var(--amber); box-shadow: inset 0 0 0 1px var(--amber-line); }
  .tag.blocked { color: #0b0b0a; background: var(--red); }
  .tk-hero { margin: 48px 0 0; }
  .tk-hero figcaption { margin-top: 12px; font-size: 0.875rem; color: var(--text-3); max-width: 72ch; }
  .hero-phone { width: min(300px, 70vw); }
  .hero-plain { display: block; width: auto; max-width: min(100%, 640px); max-height: min(78vh, 760px); height: auto; border-radius: 12px; box-shadow: 0 0 0 1px var(--line-2), 0 24px 64px rgba(0, 0, 0, 0.5); }
  .tk-nums { margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px 32px; }
  .tk-nums > div { border-top: 1px solid var(--line-2); padding-top: 16px; }
  .tk-nums dt { font-size: 2.25rem; line-height: 1; }
  .tk-nums dd { margin: 10px 0 0; color: var(--text-2); font-size: 0.9375rem; line-height: 1.45; }
  .tk-toc { position: sticky; top: 56px; z-index: 4; margin: 56px -24px 0; padding: 12px 24px; display: flex; gap: 4px 20px; flex-wrap: wrap; background: rgba(11, 11, 10, 0.94); border-bottom: 1px solid var(--line); font-size: 0.875rem; }
  .tk-toc a { color: var(--text-2); text-decoration: none; white-space: nowrap; }
  .tk-toc a:hover { color: var(--text); }
  @media (max-width: 700px) { .tk-toc { position: static; margin-inline: 0; padding-inline: 0; } }
  .tk-sec { margin-top: 96px; scroll-margin-top: 120px; }
  .tk-sec h2 { font-size: 1.875rem; line-height: 1.2; }
  .tk-sec .sub { margin: 12px 0 0; color: var(--text-2); max-width: 64ch; }
  .why-grid { margin-top: 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 48px; }
  .why-n { font-size: 0.75rem; color: var(--amber); }
  .why h3 { margin-top: 8px; font-size: 1.25rem; line-height: 1.3; }
  .why p { margin: 8px 0 0; color: var(--text-2); line-height: 1.6; }
  .threads { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; align-items: start; }
  /* Columns pack cards of different heights (with or without a screenshot) without ragged gaps. */
  .uses { list-style: none; margin: 32px 0 0; padding: 0; columns: 3 300px; column-gap: 20px; }
  .uses > .use { break-inside: avoid; margin-bottom: 20px; }
  .src-line { margin: 16px 0 0; color: var(--text-3); font: 400 0.75rem/1.5 var(--mono); }
  .src-line .tag { margin-right: 8px; }
  .video-row { margin: 24px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; padding: 16px 20px; border-radius: 12px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line-2); color: var(--text-2); }
  .video-row strong { color: var(--text); }
  .video-row .num { color: var(--text); }
  .use { display: flex; flex-direction: column; background: var(--panel); border-radius: 12px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); }
  .use-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: contain; background: var(--bg); border-bottom: 1px solid var(--line); }
    .use-body { padding: 16px 16px 18px; }
  .use-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .use h3 { font-size: 1.0625rem; line-height: 1.3; }
  .use p { margin: 8px 0 0; color: var(--text-2); font-size: 0.9375rem; line-height: 1.5; }
  .use .use-where { margin-top: 10px; }
  .use details { margin-top: 10px; font-size: 0.875rem; }
  .use summary, .shots summary { cursor: pointer; color: var(--text-2); }
  .use summary:hover, .shots summary:hover { color: var(--text); }
  .proof { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .proof li { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .proof-v { font-size: 1.5rem; line-height: 1.2; }
  .proof p { margin: 0; line-height: 1.5; }
  .proof .check { margin-top: 6px; }
  .split { margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .split > div { padding: 24px; border-radius: 12px; background: var(--panel); box-shadow: 0 0 0 1px var(--line); }
  .split > div:first-child { box-shadow: 0 0 0 1px var(--amber-line); }
  .split h3 { font-size: 1rem; }
  .split ul, .limits { margin: 12px 0 0; padding-left: 18px; color: var(--text-2); line-height: 1.6; }
  .split li + li, .limits li + li { margin-top: 8px; }
  .limits { max-width: 72ch; margin-top: 24px; }
  .video-slot { margin-top: 24px; aspect-ratio: 16 / 9; max-height: 420px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 8px; padding: 24px; text-align: center; border-radius: 12px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line-2); color: var(--text-2); }
  .video-slot .num { margin: 0; font-size: 1.5rem; color: var(--text); }
  .video-slot p { margin: 0; max-width: 46ch; }
  .video-slot.has-url { color: var(--text); font-weight: 600; text-decoration: none; }
  .shots { margin-top: 16px; }
  .shots summary { line-height: 1.5; }
  .shots table { margin-top: 16px; width: 100%; border-collapse: collapse; font-size: 0.875rem; line-height: 1.45; display: block; overflow-x: auto; }
  .shots th, .shots td { text-align: left; vertical-align: top; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); }
  .shots th { color: var(--text-3); font-weight: 500; }
  .shots td.num { white-space: nowrap; color: var(--text-2); }
  .rec-notes { margin: 16px 0 0; color: var(--text-2); font-size: 0.875rem; line-height: 1.55; }
  .tk-docs ul { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .tk-docs a { color: var(--text); text-underline-offset: 0.2em; text-decoration-color: var(--amber); }
  .tk-next { margin-top: 96px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .tk-next a { display: flex; flex-direction: column; gap: 4px; padding: 20px; border-radius: 12px; background: var(--panel); box-shadow: 0 0 0 1px var(--line); color: var(--text); text-decoration: none; font-weight: 600; font-size: 1.125rem; transition: background-color 0.2s ease; }
  .tk-next a span { font: 400 0.6875rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); }
  .tk-next a.r { text-align: right; align-items: flex-end; }
  @media (hover: hover) and (pointer: fine) { .tk-next a:hover { background: var(--raise); } }
  @media (max-width: 760px) {
    .tk-head { padding-top: 40px; }
    .tk-head h1 { font-size: 1.75rem; }
    .why-grid, .split { grid-template-columns: 1fr; gap: 32px; }
    .proof li { grid-template-columns: 1fr; gap: 6px; }
    .tk-sec { margin-top: 72px; }
  }
</style>
