---
// The tracks overview: one card per sponsor track, each linking to its page.
import { Image } from 'astro:assets';
import Landing from '../../layouts/Landing.astro';
import { TRACKS } from '../../tracks/index.ts';
import { APP_URL } from '../../site.ts';
---
<Landing title="Tracks: Tessera" description="Every HackUTD 2026 track Tessera entered: what we built for each sponsor, where it runs, and how to check it." current="tracks">
  <div class="tx">
    <header class="tx-head">
      <p class="eyebrow">HackUTD 2026</p>
      <h1>Every track runs on one shared 3D set.</h1>
      <p class="tx-lede">Tessera finds where a photo was taken and rebuilds the place as a set your group plans in. Each sponsor's product does a real job inside it.</p>
    </header>
    <dl class="tx-strip" aria-label="One number per track">
      {TRACKS.filter((t) => !t.notEntered && t.headline[0]).map((t) => (
        <div><dt class="num">{t.headline[0].value}</dt><dd><strong>{t.sponsor === 'HackUTD' ? t.prize : t.sponsor}</strong> {t.headline[0].label}</dd></div>
      ))}
    </dl>
    <ul class="tx-grid">
      {TRACKS.filter((t) => !t.notEntered).map((t) => (
        <li>
          <a class="tx-card" href={`/tracks/${t.slug}/`}>
            <Image class="tx-img" src={t.hero.img} alt="" widths={[480, 800]} sizes="(max-width: 760px) 100vw, 520px" />
            <div class="tx-body">
              <p class="tx-prize">{t.prize}</p>
              <h2>{t.sponsor === 'HackUTD' ? t.prize : t.sponsor}</h2>
              <p class="tx-line">{t.oneLine}</p>
              {t.headline[0] && <p class="tx-num"><span class="num">{t.headline[0].value}</span> {t.headline[0].label}</p>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <section class="tx-foot">
      <p>The overall prizes are judged on the whole project. Try it on the demo shoot, or read how it works. Also kept: <a href="/tracks/design/">how we designed Tessera</a> (not a track we entered).</p>
      <div class="tx-links">
        <a class="btn primary" href={APP_URL}>Try it: pick a scene</a>
        <a class="btn secondary" href="/docs/get-started/">Read the docs</a>
      </div>
    </section>
  </div>
</Landing>

<style is:global>
  .tx { max-width: 1088px; margin: 0 auto; padding: 64px 24px 96px; }
  @media (max-width: 420px) { .tx { padding-inline: 16px; } }
  .tx-head { max-width: 760px; }
  .tx .eyebrow { margin: 0; font: 400 var(--t-xs) / 1.4 var(--data); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .tx h1 { margin: 12px 0 0; font-size: var(--t-2xl); line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
  .tx-lede { margin: 16px 0 0; color: var(--text-2); font-size: var(--t-lg); line-height: 1.6; text-wrap: pretty; }
  .tx-strip { margin: 40px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
  .tx-strip div { border-top: 1px solid var(--line-2); padding-top: 12px; }
  .tx-strip dt { font-size: var(--t-xl); line-height: 1.1; color: var(--text); }
  .tx-strip dd { margin: 6px 0 0; font-size: var(--t-sm); color: var(--text-2); line-height: 1.45; }
  .tx-strip dd strong { color: var(--text); font-weight: 600; }
  .tx-grid { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .tx-card { display: flex; flex-direction: column; height: 100%; border-radius: var(--r-panel); overflow: hidden; background: var(--panel); box-shadow: 0 0 0 1px var(--line); color: var(--text); text-decoration: none; transition: box-shadow 0.2s ease; }
  @media (hover: hover) and (pointer: fine) { .tx-card:hover { box-shadow: 0 0 0 1px var(--accent-line); } }
  .tx-card:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .tx-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; background: var(--bg); border-bottom: 1px solid var(--line); }
  .tx-body { padding: 20px 20px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .tx-prize { margin: 0; font: 400 var(--t-xs) / 1.4 var(--data); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); }
  .tx-card h2 { margin: 0; font-size: var(--t-xl); font-weight: 600; letter-spacing: -0.02em; }
  .tx-line { margin: 0; color: var(--text-2); line-height: 1.55; text-wrap: pretty; }
  .tx-num { margin: auto 0 0; padding-top: 12px; color: var(--text-2); font-size: var(--t-sm); border-top: 1px solid var(--line); }
  .tx-num .num { font-family: var(--data); color: var(--text); font-size: var(--t-md); }
  .tx-foot { margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--line); }
  .tx-foot p { margin: 0; color: var(--text-2); }
  .tx-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  @media (max-width: 760px) { .tx { padding-top: 40px; } .tx h1 { font-size: var(--t-xl); } .tx-grid { grid-template-columns: 1fr; } }
</style>
