---
import { Image } from 'astro:assets';
import Landing from '../layouts/Landing.astro';
import { APP_URL, DEMO_CODE, TAGLINE } from '../site.ts';
import hero from '../assets/shots/studio-polish-prod-camera.png';
import drop from '../assets/shots/simple-drop-phone.png';
import found from '../assets/shots/simple-found-phone.png';
import yours from '../assets/shots/simple-yours-phone.png';
import there from '../assets/shots/simple-there-start-phone.png';
import simple from '../assets/shots/simple-prod-found-desktop.png';
import studio from '../assets/shots/studio-render-layers.png';

const demo = `${APP_URL}/p/${DEMO_CODE}`;
const steps = [
  { n: '01', img: drop, title: 'Drop a photo', body: 'Any photo of a mapped place, from your camera roll or a link. Each step of the solve shows as it runs: safety check, spot, lens read, match.' },
  { n: '02', img: found, title: 'Found it', body: 'Where to stand, which way to face and which lens, as "2.2x on your iPhone\'s main camera". The photo blends over the 3D view so you can check the answer yourself.' },
  { n: '03', img: yours, title: 'Make it yours', body: 'Add friends, change the lens, move the sun to golden hour, describe a change in words. The render puts your people into your own photo.' },
  { n: '04', img: there, title: 'Take me there', body: 'Walk to the mark with the original as a ghost over your camera. Friends planning at home watch your dot move.' },
];
const numbers = [
  { v: '10 of 11', l: 'held out photos placed at the DUMBO spot. The eleventh said "Couldn\'t place" instead of guessing.', href: '/docs/how-it-works/solve/' },
  { v: '3%', l: 'median focal length error on those photos, with a median solve of 15.8 s on a CPU.', href: '/docs/how-it-works/solve/' },
  { v: '900 of 900', l: 'set edits committed when three people dragged objects at 10 Hz for 30 s. Median round trip 42 to 50 ms.', href: '/tracks/spacetime/' },
  { v: '72.4%', l: 'of long lens photos flagged by our fine tuned Nemotron Nano VL on landmarks it never saw. OpenAI zero shot: 48.3%.', href: '/tracks/nvidia/' },
];
const tracks = [
  { name: 'NVIDIA', line: 'Nemotron turns words into set edits, rebuilds the scene from your photo, checks each render\'s physics, and reads lenses with our own fine tune.', href: '/tracks/nvidia/' },
  { name: 'SpacetimeDB', line: 'The set is the database. Every person, prop, light and camera is a row that every screen, phone and worker shares live.', href: '/tracks/spacetime/' },
  { name: 'Photon', line: 'The set reaches people on iMessage, Telegram, SMS, WhatsApp and email, and by phone call, each in that app\'s own form.', href: '/tracks/photon/' },
  { name: 'Best Design', line: 'Three directions in Figma before any code. The dark one became Studio, the light one became Simple, over one live set.', href: '/tracks/design/' },
  { name: 'Vultr', line: 'Production runs on a Vultr VM in Dallas, with Vultr Object Storage and Vultr Serverless Inference. So does this site.', href: '/tracks/vultr/' },
];
const faq = [
  { q: 'Where does it work today?', a: 'At one mapped spot: the Manhattan Bridge view from Washington St in DUMBO, Brooklyn. A photo from a place we have not mapped gets an honest "we haven\'t mapped this spot". Mapping a spot takes about 150 photos and about 23 minutes on a CPU.' },
  { q: 'Does it find the spot from Google\'s 3D map?', a: 'No. The solver matches your photo against our own 3D model, built from 155 Creative Commons photos. Google Photorealistic 3D Tiles only draw the planning view, with Google\'s credits on screen, and never enter a render, an export or an AI step.' },
  { q: 'Are the renders real photos?', a: 'No. Every render is labelled "AI interpretation". Your people and props are composited into your own photo with shadows from the real sun position, and the AI generator is blended only around them, so the rest of your photo stays as it was.' },
  { q: 'Do my friends need the app?', a: 'No. Anyone with the link joins in a browser. The set can also reach people by text and by phone call through Photon; the Telegram bot is live, and the other lines are being connected.' },
  { q: 'What happens to my photo?', a: 'It is stored so everyone in your shoot can see it, and NVIDIA hosted models read it to place objects and make renders. Your position is shared only while the camera page is open. The privacy page lists every service that touches it.' },
  { q: 'Can someone use it to find where a person lives?', a: 'ShotMatch can only place a photo at a spot we mapped, and we map public places that are already famous. Nemotron Content Safety screens every upload.' },
];
---
<Landing title="ShotMatch: stand where the photo was taken">
  <section class="hero">
    <div class="wrap hero-copy">
      <p class="eyebrow">HackUTD 2026</p>
      <h1>Stand where the photo was taken.<br />Then make the shot yours.</h1>
      <p class="lede">Drop a photo of a place. ShotMatch finds where the photographer stood, which way they faced and what lens they used, rebuilds the place as a 3D set, and your group plans its own version there together.</p>
      <div class="ctas">
        <a class="btn primary" href={demo}>Try the Manhattan Bridge shot</a>
        <a class="btn quiet" href="/docs/get-started/">Read the docs</a>
      </div>
      <p class="proof"><span class="num">10 of 11</span> held out photos placed, median focal error <span class="num">3%</span></p>
    </div>
    <figure class="wrap hero-shot">
      <Image src={hero} alt="ShotMatch Studio looking through Cam A at the Manhattan Bridge from Washington St: the original photo as the backplate, two placed walking figures, a 51 mm lens at f/2.8 focused at 2.1 m, and the golden hour band on the timeline." widths={[800, 1200, 1600, 2000]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" fetchpriority="high" />
      <figcaption>Studio, looking through the shot camera at session {DEMO_CODE}. The photo is the backplate; the two figures and the lens are part of the shared set.</figcaption>
    </figure>
  </section>

  <section class="wrap problem" aria-labelledby="problem-h">
    <h2 id="problem-h">A photo shows you the place, not where to stand</h2>
    <div class="cols">
      <p>Google Lens names a landmark in a second. The standing spot, the direction and the zoom are still guesswork, so people ask strangers online, message photographers who often won't say, or walk around until it lines up. A phone on 1x still gets a different picture when the original was shot from farther back with a longer lens.</p>
      <ul class="asks">
        <li><a href="https://reddit.com/r/AskPhotography/comments/1wpvtk0/">A couple's photographer "just couldn't get the focal length/settings right"</a> <span>r/AskPhotography, 1,215 upvotes</span></li>
        <li><a href="https://reddit.com/r/WeddingPhotography/comments/1hr7i2c/">A wedding photographer with 10 years in can't find the spot in her sister's elopement photos</a> <span>r/WeddingPhotography</span></li>
        <li><a href="https://triptins.com/manhattan-bridge-view-spot-dumbo/">Guides to our demo shot disagree on which block to stand on</a> <span>triptins.com</span></li>
      </ul>
    </div>
  </section>

  <section class="wrap flow" aria-labelledby="flow-h">
    <h2 id="flow-h">Four steps, one photo</h2>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <Image src={s.img} alt={`ShotMatch Simple on a phone: ${s.title}`} widths={[320, 480, 640]} sizes="(max-width: 760px) 80vw, 280px" />
          <span class="num step-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap reveal" aria-label="What ShotMatch does">
    <p class="reveal-text" data-reveal>A photo shows you the place. ShotMatch tells you where to stand, which way to face and which lens to bring.</p>
  </section>

  <section class="wrap views" aria-labelledby="views-h">
    <h2 id="views-h">Simple for anyone, Studio for photographers</h2>
    <p class="sub">Both views read and write the same live set, so a friend on a phone and a photographer at a laptop plan one shot together. One switch moves between them.</p>
    <div class="pair">
      <figure>
        <Image src={simple} alt="ShotMatch Simple on a laptop: the Manhattan Bridge photo with placed figures beside the answer card reading Solid match, facing 4 degrees N, lens 2.2x on your iPhone's main camera, and the next golden hour." widths={[700, 1000, 1400]} sizes="(max-width: 900px) 100vw, 580px" />
        <figcaption><strong>Simple.</strong> Light and phone first: the answer in plain words, one tap presets, and Take me there.</figcaption>
      </figure>
      <figure>
        <Image src={studio} alt="ShotMatch Studio in its dark theme: the outliner and asset library on the left, the view through Cam A in the middle, an AI render labelled AI interpretation beside it, and the render layers panel on the right." widths={[700, 1000, 1400]} sizes="(max-width: 900px) 100vw, 580px" />
        <figcaption><strong>Studio.</strong> The Darkroom set editor: real bodies and lenses, depth of field, render layers, Nemotron's command bar and the live data inspector.</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap numbers" aria-labelledby="numbers-h">
    <h2 id="numbers-h">Measured, with the misses</h2>
    <dl>
      {numbers.map((n) => (
        <div>
          <dt class="num">{n.v}</dt>
          <dd>{n.l} <a href={n.href}>Source</a></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap tracks" aria-labelledby="tracks-h">
    <h2 id="tracks-h">Every sponsor track runs on the same set</h2>
    <ul class="track-list">
      {tracks.map((t) => (
        <li>
          <a href={t.href}>
            <span class="t-name">{t.name}</span>
            <span class="t-line">{t.line}</span>
            <span class="t-go" aria-hidden="true">Read</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap faq" aria-labelledby="faq-h">
    <h2 id="faq-h">Questions</h2>
    <div class="faq-list">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="wrap final">
    <h2>{TAGLINE}</h2>
    <div class="ctas">
      <a class="btn primary" href={demo}>Try the Manhattan Bridge shot</a>
      <a class="btn quiet" href={APP_URL}>Open the app with your own photo</a>
    </div>
  </section>
</Landing>

<script>
  // Words of the tagline brighten in reading order as the section crosses the middle of the screen.
  const el = document.querySelector<HTMLElement>('[data-reveal]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = el.textContent!.trim().split(/\s+/);
    el.textContent = '';
    const spans = words.map((w, i) => {
      const s = document.createElement('span');
      s.textContent = w + (i < words.length - 1 ? ' ' : '');
      el.append(s);
      return s;
    });
    el.classList.add('armed');
    let queued = false;
    const update = () => {
      queued = false;
      const r = el.getBoundingClientRect();
      const start = innerHeight * 0.85, end = innerHeight * 0.35;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.5)));
      const lit = Math.round(p * spans.length);
      spans.forEach((s, i) => s.classList.toggle('on', i < lit));
    };
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) addEventListener('scroll', onScroll, { passive: true });
      else removeEventListener('scroll', onScroll);
      update();
    });
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    io.observe(el);
  }
</script>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  @media (max-width: 420px) { .wrap { padding: 0 16px; } }
  section { margin-top: 96px; }
  h1, h2, h3 { font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; margin: 0; }
  h2 { font-size: 1.875rem; line-height: 2.25rem; max-width: 680px; }
  p { text-wrap: pretty; }
  .num { font-family: var(--mono); font-feature-settings: 'tnum'; letter-spacing: -0.02em; }
  .eyebrow { font-family: var(--mono); font-size: 0.75rem; line-height: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--amber); margin: 0 0 16px; }

  .hero { margin-top: 0; padding-top: 80px; }
  .hero h1 { font-size: 3.75rem; line-height: 1; max-width: 900px; }
  .lede { font-size: 1.25rem; line-height: 1.75rem; color: var(--text-2); max-width: 680px; margin: 24px 0 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border-radius: var(--r); font-weight: 600; font-size: 1rem; text-decoration: none; transition: background-color 0.25s var(--ease), color 0.25s var(--ease); }
  .btn:active { transform: translateY(1px); }
  .btn.primary { background: var(--amber); color: var(--amber-ink); }
  .btn.primary:hover { background: #f5b65c; }
  .btn.quiet { color: var(--text); background: var(--raise); }
  .btn.quiet:hover { background: var(--field); }
  .proof { margin: 24px 0 0; color: var(--text-3); font-size: 0.875rem; }
  .proof .num { color: var(--text); }
  .hero-shot { margin: 48px auto 0; }
  .hero-shot img { display: block; width: 100%; height: auto; border-radius: var(--r); border: 1px solid var(--line); }
  figcaption { margin-top: 12px; color: var(--text-3); font-size: 0.875rem; line-height: 1.25rem; max-width: 72ch; }
  figcaption strong { color: var(--text); font-weight: 600; }

  .cols { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; margin-top: 24px; }
  .cols > p { margin: 0; font-size: 1.125rem; line-height: 1.75rem; color: var(--text-2); }
  .asks { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .asks li { border-top: 1px solid var(--line); padding-top: 16px; }
  .asks a { color: var(--text); text-decoration: none; font-weight: 500; }
  .asks a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
  .asks span { display: block; margin-top: 4px; color: var(--text-3); font-size: 0.75rem; font-family: var(--mono); }

  .steps { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .steps img { display: block; width: 100%; height: auto; aspect-ratio: 393 / 852; object-fit: cover; object-position: top; border-radius: 16px; border: 1px solid var(--line); background: var(--panel); }
  .step-n { display: block; margin-top: 16px; color: var(--amber); font-size: 0.75rem; }
  .steps h3 { font-size: 1.25rem; line-height: 1.75rem; margin-top: 4px; }
  .steps p { margin: 8px 0 0; color: var(--text-2); font-size: 0.875rem; line-height: 1.25rem; }

  .reveal-text { font-size: 3rem; line-height: 1.1; font-weight: 600; letter-spacing: -0.02em; max-width: 900px; margin: 0; text-wrap: balance; }
  .reveal-text.armed :global(span) { color: rgba(242, 239, 232, 0.28); transition: color 0.6s var(--ease); }
  .reveal-text.armed :global(span.on) { color: var(--text); }

  .sub { color: var(--text-2); max-width: 680px; margin: 16px 0 0; font-size: 1.125rem; line-height: 1.75rem; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; }
  .pair figure { margin: 0; }
  .pair img { display: block; width: 100%; height: auto; border-radius: var(--r); border: 1px solid var(--line); }

  .numbers dl { margin: 40px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .numbers dl > div { border-top: 1px solid var(--line-2); padding-top: 16px; }
  .numbers dt { font-size: 1.875rem; line-height: 2.25rem; color: var(--text); }
  .numbers dd { margin: 12px 0 0; color: var(--text-2); font-size: 0.875rem; line-height: 1.25rem; }
  .numbers dd a { color: var(--text-3); }
  .numbers dd a:hover { color: var(--text); }

  .track-list { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .track-list a { display: grid; grid-template-columns: 180px 1fr auto; gap: 24px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background-color 0.25s var(--ease); }
  .track-list a:hover { background: var(--panel); }
  .t-name { font-weight: 600; font-size: 1.25rem; line-height: 1.75rem; }
  .t-line { color: var(--text-2); }
  .t-go { font-size: 0.875rem; font-weight: 600; color: var(--amber); padding-right: 12px; }

  .faq-list { margin-top: 32px; border-top: 1px solid var(--line); max-width: 860px; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 600; font-size: 1.125rem; line-height: 1.75rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--mono); color: var(--text-3); }
  .faq details[open] summary::after { content: '\2212'; }
  .faq details p { margin: 0 0 24px; color: var(--text-2); max-width: 70ch; }

  .final { margin-bottom: 96px; padding-top: 48px; border-top: 1px solid var(--line); }
  .final h2 { font-size: 2.25rem; line-height: 2.5rem; }

  @media (max-width: 900px) {
    .hero h1 { font-size: 3rem; }
    .cols, .pair { grid-template-columns: 1fr; gap: 32px; }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .numbers dl { grid-template-columns: repeat(2, 1fr); }
    .reveal-text { font-size: 2.25rem; }
  }
  @media (max-width: 560px) {
    section { margin-top: 64px; }
    .hero { padding-top: 48px; }
    .hero h1 { font-size: 2.25rem; line-height: 2.5rem; }
    .lede { font-size: 1.125rem; line-height: 1.75rem; }
    .hero h1 br { display: none; }
    .steps { grid-template-columns: 1fr 1fr; gap: 16px; }
    .numbers dl { grid-template-columns: 1fr; gap: 24px; }
    .track-list a { grid-template-columns: 1fr; gap: 4px; }
    .t-go { display: none; }
    .reveal-text { font-size: 1.875rem; line-height: 2.25rem; }
    .final h2 { font-size: 1.875rem; line-height: 2.25rem; }
  }
</style>
