---
// Landing v3, built like the app: Studio's Darkroom colours, its 6 / 10 px shapes, 36 px buttons and type scale.
// Six short sections, each carried by the real product: the hero scrubs Through Cam A from golden hour to dusk with the
// live sun; the four steps; photos from anywhere; the camera; one live set and the tracks.
// The HTML and CSS below are the complete static page (no JavaScript, or prefers-reduced-motion).
// src/scripts/landing.ts adds the scroll scrub, the pinned steps and the camera switch on top.
import { Image } from 'astro:assets';
import Landing from '../layouts/Landing.astro';
import Iphone from '../components/frames/Iphone.astro';
import Browser from '../components/frames/Browser.astro';
import { APP_URL, DEMO_CODE } from '../site.ts';
import { TRACKS } from '../tracks/index.ts';
import { research } from '../research.ts';
import drop from '../assets/shots/simple-drop-phone.png';
import found from '../assets/shots/simple-found-phone.png';
import yours from '../assets/shots/simple-yours-phone.png';
import there from '../assets/shots/simple-there-start-phone.png';
import live from '../assets/shots/studio-live-prod.png';
import anywhere from '../assets/shots/simple-anywhere-phone.png';
import anywhereArea from '../assets/shots/simple-anywhere-area-phone.png';
import renderPair from '../assets/camera/render-pair.png';
import vf16 from '../assets/camera/vf-16mm.png';
import vf35 from '../assets/camera/vf-35mm.png';
import vf85 from '../assets/camera/vf-85mm-f1.4.png';
import vf85s from '../assets/camera/vf-85mm-f11.png';
import vf135 from '../assets/camera/vf-135mm.png';
import vfIso from '../assets/camera/vf-iso6400.png';

// Through Cam A on the demo shoot, Saturday Nov 7 in DUMBO, one frame per time of day (file name = HHMM, local time).
const heroFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.png', { eager: true });
const frames = Object.entries(heroFiles).sort(([a], [b]) => a.localeCompare(b)).map(([path, m]) => {
  const hhmm = path.match(/(\d{4})\.png$/)![1];
  const h = Number(hhmm.slice(0, 2)), min = Number(hhmm.slice(2));
  return { img: m.default, minutes: h * 60 + min, label: `${h - 12}:${hhmm.slice(2)} PM` };
});
const STILL = frames.findIndex((f) => f.label === '4:35 PM'); // the frame shown without motion: golden hour
const T0 = 16 * 60, T1 = 17 * 60 + 10; // the scrubber's span, 4:00 to 5:10 PM
const at = (min: number) => `${(((min - T0) / (T1 - T0)) * 100).toFixed(2)}%`;
const GOLD = [16 * 60 + 6, 17 * 60 + 2]; // golden hour 4:06 to 5:02 PM, from the app's timeline
const SUNSET = 16 * 60 + 47;

const steps = [
  { img: drop, title: 'Drop a photo', alt: 'Simple on a phone: Where did they stand? with a drop zone for a photo' },
  { img: found, title: 'Found it', alt: 'Simple on a phone: Solid match, Manhattan Bridge from Washington St, facing 4 degrees N, lens 2.2x' },
  { img: yours, title: 'Make it yours', alt: 'Simple on a phone: the original photo beside an AI render with two people at golden hour' },
  { img: there, title: 'Take me there', alt: 'Simple on a phone: Walk to the mark, with Open camera and compass' },
];

// Real Through Cam A screenshots, cropped to the viewfinder; the readout is the one printed in each frame.
const lenses = [
  { key: '16', name: '16 mm', img: vf16, readout: '16 mm  f/4  1/320 s  ISO 100', note: 'Wider than the photo: the 3D set fills in beyond its edges.' },
  { key: '35', name: '35 mm', img: vf35, readout: '35 mm  f/4  1/320 s  ISO 100', note: 'Close to the photo\'s own framing.' },
  { key: '85', name: '85 mm f/1.4', img: vf85, readout: '85 mm  f/1.4  1/1600 s  ISO 50', note: 'Focus on the person at 5.1 m; the bridge falls out of focus.' },
  { key: '85s', name: '85 mm f/11', img: vf85s, readout: '85 mm  f/11  1/100 s  ISO 100', note: 'Stopped down: sharp to the bridge, with a diffraction warning past f/7.7.' },
  { key: '135', name: '135 mm', img: vf135, readout: '135 mm  f/4  1/320 s  ISO 100', note: 'A tight crop of the centre; Cam A steps back to keep the person\'s size.' },
  { key: 'iso', name: 'ISO 6400', img: vfIso, readout: '35 mm  f/8  1/8000 s  ISO 6400', note: 'Sensor noise at high ISO, measured per body.' },
];
const firstLens = 2;
const spacetime = TRACKS.find((t) => t.slug === 'spacetime')?.headline[0];
const demo = `${APP_URL}/p/${DEMO_CODE}`;
---
<Landing title="Tessera: stand where the photo was taken">
  <section class="hero" data-hero>
    <div class="hero-copy">
      <h1>Stand where the photo was taken.</h1>
      <p class="lede">Drop a photo of a place. Tessera finds where the photographer stood and the lens they used, then rebuilds the spot so your group can plan the shot.</p>
      <div class="ctas">
        <a class="btn primary" href={APP_URL}>Try it: pick a scene</a>
        <a class="btn ghost" href="#steps">How it works</a>
      </div>
      <p class="hero-watch"><a href="https://youtu.be/KxeUG-_GlKs">Watch the 2-minute video</a> · <a href="/reels/">10 reels</a></p>
    </div>
    <figure class="hero-stage">
      <Browser url={`app.tesseraphoto.com/studio/${DEMO_CODE}`} class="hero-window">
        {frames.map((f, i) => (
          <Image class="h-frame" data-min={f.minutes} src={f.img} alt={i === STILL ? 'Studio in World view over the Google Photorealistic 3D Tiles of DUMBO: Cam A and its frustum on Washington St under the Manhattan Bridge, the photo in the corner, the camera inspector and the time of day on the timeline' : ''} aria-hidden={i === STILL ? undefined : 'true'} widths={[800, 1200, 1600]} sizes="(max-width: 900px) 190vw, 1100px" loading={i === STILL ? 'eager' : 'lazy'} fetchpriority={i === STILL ? 'high' : undefined} style={i === STILL ? undefined : 'opacity:0'} />
        ))}
      </Browser>
      <div class="h-time" aria-hidden="true">
        <span class="h-clock num" data-clock>{frames[STILL]?.label}</span>
        <div class="h-track">
          <span class="h-gold" style={`left:${at(GOLD[0])};width:calc(${at(GOLD[1])} - ${at(GOLD[0])})`} />
          <span class="h-tick" style={`left:${at(SUNSET)}`} />
          <span class="h-head" data-head style={`left:${at(frames[STILL]?.minutes ?? GOLD[0])}`} />
        </div>
        <span class="h-legend">Live sun, Washington St, Saturday Nov 7. Golden hour 4:06 to 5:02, sunset 4:47.</span>
      </div>
    </figure>
  </section>

  {research && (
    <section class="research" aria-labelledby="research-h">
      <p class="label">The problem</p>
      <h2 id="research-h"><span class="num">{research.count}</span> {research.line}</h2>
      <p class="research-detail">{research.detail}</p>
      <ul class="quotes">
        {research.quotes.map((q) => (
          <li>
            <figure>
              <blockquote><p>"{q.text}"</p></blockquote>
              <figcaption><a href={q.href}>{q.where}</a></figcaption>
            </figure>
            <img src={q.shot} alt={q.alt} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
      <a class="more" href={research.href}>Read the research: 8 posts, how we searched, what we counted</a>
    </section>
  )}

  <section class="steps" id="steps" data-steps aria-label="How it works, in four steps">
    <ol class="steps-list">
      {steps.map((s, i) => (
        <li class="step" data-step={i}>
          <div class="step-phone"><Iphone><Image src={s.img} alt={s.alt} widths={[400, 800]} sizes="(max-width: 760px) 70vw, 340px" /></Iphone></div>
          <p class="step-title"><span class="num">0{i + 1}</span>{s.title}</p>
        </li>
      ))}
    </ol>
    <div class="steps-rail" aria-hidden="true">{steps.map(() => <span />)}</div>
  </section>
  <p class="proof-line"><span class="num">10 of 11</span> held-out photos placed, <span class="num">3%</span> median focal error. <a href="/docs/why-tessera/#measured">How we measured</a></p>

  <section class="split anywhere" aria-labelledby="anywhere-h">
    <div class="copy">
      <p class="label">Works anywhere</p>
      <h2 id="anywhere-h">Any photo opens a shoot at its place.</h2>
      <p>With GPS in the photo, Tessera uses it. Without, Nemotron reads the signs, landmarks and script, and OpenStreetMap finds the place it names, in about <span class="num">2.5 s</span>. If the guess is wrong, search a name, tap the exact spot, or circle an area and Nemotron looks again inside it. The exact standing spot and lens are solved where the place has a mapped model, like DUMBO; anywhere else the shoot says it is approximate.</p>
      <p class="fine">Coordinates come from the photo's GPS or the geocoder, never from the model.</p>
    </div>
    <figure class="anywhere-shot">
      <div class="anywhere-phones">
        <div class="anywhere-phone"><Iphone><Image src={anywhere} alt="Simple on a phone: a photo of the Eiffel Tower from the Seine with no GPS, marked Approximate, Eiffel Tower, Paris, Nemotron's guess from the photo, with Change place, facing not measured and lens unknown" widths={[400, 800]} sizes="(max-width: 900px) 42vw, 240px" loading="lazy" /></Iphone></div>
        <div class="anywhere-phone"><Iphone><Image src={anywhereArea} alt="The same shoot after Change place: Search, Exact spot and Area, with Area chosen: a dark map of Paris with a 1.5 km circle to drag over where the photo was taken, and Find it in this area" widths={[400, 800]} sizes="(max-width: 900px) 42vw, 240px" loading="lazy" /></Iphone></div>
      </div>
      <figcaption>Production, a photo with no GPS: Nemotron's guess, then Change place and circle the area. Photo: <a href="https://commons.wikimedia.org/wiki/File:Eiffel_Tower,_Paris,_France_(Unsplash_PM4VZZn-YyM).jpg">John Towner</a>, CC0.</figcaption>
    </figure>
  </section>

  <section class="split camera" data-camera data-lenses={JSON.stringify(Object.fromEntries(lenses.map((l) => [l.key, { note: l.note, readout: l.readout }])))} aria-labelledby="camera-h">
    <div class="copy">
      <p class="label">A real camera</p>
      <h2 id="camera-h">Plan with the lens you own.</h2>
      <p>Pick from 19 bodies and 67 lenses. Focal length, aperture, shutter and ISO behave like the real camera: framing, depth of field, diffraction, exposure and noise.</p>
      <div class="seg" role="group" aria-label="Camera settings">
        {lenses.map((l, i) => <button type="button" data-lens={l.key} aria-pressed={String(i === firstLens)}>{l.name}</button>)}
      </div>
      <p class="lens-note" data-lens-note aria-live="polite">{lenses[firstLens].note}</p>
    </div>
    <figure class="vf">
      <div class="vf-stack">
        {lenses.map((l, i) => (
          <Image class="vf-img" data-lens-img={l.key} src={l.img} alt={`Through Cam A at ${l.readout.replace(/\s+/g, ' ')}: the Manhattan Bridge photo with a placed figure in focus at 5.1 m`} widths={[400, 800]} sizes="(max-width: 900px) 80vw, 420px" loading="lazy" style={i === firstLens ? undefined : 'opacity:0'} />
        ))}
      </div>
      <figcaption class="num" data-lens-readout>CAM A  {lenses[firstLens].readout}</figcaption>
    </figure>
  </section>

  <section class="bake" aria-labelledby="bake-h">
    <figure>
      <Image src={renderPair} alt="Through Cam A on the left, with two grey figures on the photo; on the right the AI render from the same camera, with two real people walking on Washington St under the Manhattan Bridge" widths={[800, 1200, 1800]} sizes="(max-width: 1100px) 100vw, 1040px" loading="lazy" />
    </figure>
    <div class="bake-copy">
      <h2 id="bake-h">The render goes through the same camera.</h2>
      <p>Depth of field from the set's own depth, lens distortion and chromatic aberration from lensfun, vignetting, handheld shake, white balance and sensor noise are baked into the final image from Cam A's settings.</p>
    </div>
  </section>

  <section class="split live" aria-labelledby="live-h">
    <div class="copy">
      <p class="label">One live set</p>
      <h2 id="live-h">Everyone plans on the same set.</h2>
      <p>Simple on a phone, Studio on a laptop, a text thread on Telegram. Every object, person, light and camera is a row in one SpacetimeDB module, so an edit anywhere shows up everywhere.</p>
      {spacetime && <p class="stat"><span class="num">{spacetime.value}</span> {spacetime.label}</p>}
    </div>
    <div class="live-shot">
      <Browser url={`app.tesseraphoto.com/studio/${DEMO_CODE}`}>
        <Image src={live} alt="Studio with the People and live data drawer open: Ben and Maya online, connected to Maincloud, and the live feed of SpacetimeDB row changes" widths={[800, 1200, 1600]} sizes="(max-width: 900px) 100vw, 640px" loading="lazy" />
      </Browser>
    </div>
  </section>

  <section class="tracks" aria-labelledby="tracks-h">
    <p class="label" id="tracks-h">HackUTD 2026 tracks</p>
    <ul>
      {TRACKS.filter((t) => !t.notEntered).map((t) => (
        <li>
          <a href={`/tracks/${t.slug}/`}>
            <span class="t-name">{t.sponsor === 'HackUTD' ? t.prize : t.sponsor}</span>
            <span class="t-line">{t.oneLine}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="final">
    <h2>Try it on the Manhattan Bridge shot.</h2>
    <div class="ctas"><a class="btn primary" href={APP_URL}>Try it: pick a scene</a><a class="btn secondary" href={demo}>Open the shared demo shoot</a></div>
  </section>
</Landing>

<script src="../scripts/landing.ts"></script>

<style is:global>
  /* Global on purpose: the selectors reach <img> elements rendered by astro:assets and the frame components. */
  main > section, main > .proof-line { padding-inline: 24px; }
  @media (max-width: 420px) { main > section, main > .proof-line { padding-inline: 16px; } }
  main h1, main h2 { margin: 0; font-weight: 600; text-wrap: balance; }
  main h2 { font-size: var(--t-xl); line-height: 1.2; letter-spacing: -0.02em; }
  main p { text-wrap: pretty; }
  .num { letter-spacing: -0.02em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 8px; }

  /* Hero: copy beside the window on wide screens, above it on narrow ones. */
  .hero { min-height: calc(100svh - var(--header-h)); display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); gap: 48px; align-items: center; align-content: center; max-width: 1560px; margin: 0 auto; padding-block: 32px; }
  .hero h1 { font-size: var(--t-3xl); line-height: 1.05; letter-spacing: -0.03em; }
  .lede { margin: 16px 0 0; font-size: var(--t-lg); line-height: 1.5; color: var(--text-2); }
  .hero .ctas { margin-top: 32px; }
  .hero-stage { margin: 0; width: min(100%, calc((100svh - var(--header-h) - 132px) * 1.48)); justify-self: center; }
  .h-frame { position: absolute; inset: 0; outline: 0 !important; }
  .h-time { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 8px 16px; margin-top: 16px; }
  .h-clock { font-size: var(--t-sm); color: var(--text); min-width: 7ch; }
  .h-track { position: relative; height: 24px; border-radius: var(--r); background: var(--panel); box-shadow: 0 0 0 1px var(--line); }
  .h-gold { position: absolute; top: 4px; bottom: 4px; border-radius: 3px; background: color-mix(in srgb, var(--warm) 22%, transparent); }
  .h-tick { position: absolute; top: 4px; bottom: 4px; width: 1px; background: var(--line-2); }
  .h-head { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; border-radius: 1px; background: var(--accent); }
  .h-legend { grid-column: 1 / -1; font-size: var(--t-xs); color: var(--text-3); font-family: var(--data); }

  /* Research: a count, three quotes, a link. Filled from src/research.ts. */
  .research { max-width: 1088px; margin: 96px auto 0; }
  .research h2 { margin-top: 12px; max-width: 30ch; }
  .research h2 .num { color: var(--accent); }
  .research-detail { margin: 12px 0 0; color: var(--text-2); font-size: var(--t-sm); }
  .quotes { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 32px; }
  .quotes li { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 32px; align-items: start; padding-top: 32px; border-top: 1px solid var(--line); }
  .quotes figure { margin: 0; }
  .quotes blockquote { margin: 0; color: var(--text); font-size: var(--t-lg); line-height: 1.4; letter-spacing: -0.01em; }
  .quotes blockquote p { margin: 0; }
  .quotes figcaption { margin-top: 12px; }
  .quotes img { width: 100%; height: auto; border-radius: var(--r-panel); }
  .quotes a, .more, .proof-line a { color: var(--text-2); font-size: var(--t-sm); text-underline-offset: 0.2em; }
  .quotes a:hover, .more:hover, .proof-line a:hover { color: var(--text); }
  .more { display: inline-block; margin-top: 24px; }

  /* Steps: four phones in a row when static; one pinned phone that changes screens with motion. */
  .steps { max-width: 1200px; margin: 96px auto 0; }
  .steps-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .step-phone { max-width: 280px; margin: 0 auto; }
  .step-title { margin: 16px 0 0; text-align: center; font-size: var(--t-lg); font-weight: 600; letter-spacing: -0.01em; }
  .step-title .num { display: block; font-size: var(--t-xs); color: var(--accent); margin-bottom: 4px; }
  .steps-rail { display: none; }
  .proof-line { max-width: 1088px; margin: 32px auto 0; text-align: center; color: var(--text-2); font-size: var(--t-sm); }
  .proof-line .num { color: var(--text); }

  /* Copy beside a panel or a picture. */
  .split { max-width: 1088px; margin: 128px auto 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .split .copy p:not(.label) { margin: 16px 0 0; color: var(--text-2); max-width: 46ch; }
  .split h2 { margin-top: 12px; }

  .split .copy p.fine { margin-top: 16px; color: var(--text-3); font-size: var(--t-sm); }
  .anywhere-shot { margin: 0; justify-self: center; text-align: center; }
  .anywhere-phones { display: flex; justify-content: center; gap: 16px; }
  .anywhere-phone { width: min(240px, 42vw); }
  .anywhere-shot figcaption { margin: 16px auto 0; max-width: 44ch; color: var(--text-3); font-size: var(--t-xs); line-height: 1.5; }
  .anywhere-shot figcaption a { color: inherit; }

  .camera .seg { margin-top: 24px; flex-wrap: wrap; }
  .lens-note { min-height: 3em; font-size: var(--t-sm); }
  .vf { margin: 0; justify-self: center; width: min(100%, 420px); }
  .vf-stack { position: relative; aspect-ratio: 560 / 747; border-radius: var(--r-panel); overflow: hidden; background: var(--panel); box-shadow: 0 0 0 1px var(--line); }
  .vf-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 160ms ease-out; outline: 0 !important; }
  .vf figcaption { margin-top: 12px; font-size: var(--t-xs); color: var(--text-2); white-space: pre; text-align: center; }

  .bake { max-width: 1088px; margin: 64px auto 0; }
  .bake figure { margin: 0; }
  .bake img { display: block; width: 100%; height: auto; border-radius: var(--r-panel); }
  .bake-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; margin-top: 24px; }
  .bake-copy h2 { font-size: var(--t-lg); line-height: 1.3; }
  .bake-copy p { margin: 0; color: var(--text-2); }

  .live .stat { font-size: var(--t-sm); }
  .live .stat .num { display: block; margin-bottom: 4px; color: var(--text); font-size: var(--t-xl); }

  /* Tracks as rows: name, then one line. */
  .tracks { max-width: 1088px; margin: 128px auto 0; }
  .tracks ul { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .tracks li { border-bottom: 1px solid var(--line); }
  .tracks a { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 24px; align-items: baseline; padding: 16px 8px; margin-inline: -8px; border-radius: var(--r); color: var(--text-2); text-decoration: none; transition: background-color 120ms ease-out; }
  .tracks a:hover { background: var(--panel); }
  .hero-watch { margin: 16px 0 0; color: var(--text-3); font-size: var(--t-sm); }
  .hero-watch a { color: var(--text-2); }
  .hero-watch a:hover { color: var(--text); }
  .t-name { color: var(--text); font-size: var(--t-lg); font-weight: 600; letter-spacing: -0.01em; }
  .t-line { font-size: var(--t-sm); line-height: 1.5; }

  .final { max-width: 1088px; margin: 128px auto 128px; text-align: center; }
  .final .ctas { justify-content: center; margin-top: 24px; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 32px; min-height: auto; padding-block: 40px 32px; }
    .hero h1 { font-size: var(--t-2xl); }
    .hero-stage { width: 100%; }
    /* On a phone the whole window is too small to read, so it shows the viewfinder and the inspector around it. */
    .hero-window .browser-screen { aspect-ratio: 1 / 1 !important; }
    .h-frame { object-position: 45.5% 50% !important; }
    .steps-list { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
    .split { grid-template-columns: 1fr; gap: 32px; margin-top: 96px; }
    .bake-copy { grid-template-columns: 1fr; gap: 12px; }
    .quotes li { grid-template-columns: 1fr; gap: 16px; }
    .tracks { margin-top: 96px; }
    .tracks a { grid-template-columns: 1fr; gap: 4px; }
  }

  /* With motion: the hero pins while the time scrubs, and the steps stack into one phone. */
  html.motion .steps { min-height: calc(100svh - var(--header-h)); max-width: 1040px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 48px; margin-top: 64px; }
  html.motion .steps-list { display: block; position: relative; height: min(76svh, 720px); }
  html.motion .step { position: absolute; inset: 0; display: grid; grid-template-columns: auto minmax(0, 400px); justify-content: center; align-items: center; gap: 80px; }
  html.motion .step + .step { opacity: 0; }
  html.motion .step-phone { height: 100%; width: auto; aspect-ratio: 433 / 882; max-width: none; margin: 0; }
  html.motion .step-title { text-align: left; font-size: var(--t-2xl); line-height: 1.1; letter-spacing: -0.03em; margin: 0; }
  html.motion .step-title .num { font-size: var(--t-sm); margin-bottom: 12px; }
  html.motion .steps-rail { display: flex; flex-direction: column; gap: 8px; }
  html.motion .steps-rail span { width: 2px; height: 32px; border-radius: 1px; background: var(--line-2); }
  html.motion .steps-rail span.on { background: var(--accent); }
  @media (max-width: 900px) {
    html.motion .steps { grid-template-columns: 1fr; gap: 0; }
    html.motion .steps-list { height: min(78svh, 680px); }
    html.motion .step { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); gap: 16px; justify-items: center; }
    html.motion .step-title { order: -1; text-align: center; font-size: var(--t-xl); }
    html.motion .step-phone { height: 100%; min-height: 0; }
    html.motion .steps-rail { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .vf-img { transition: none; } }
