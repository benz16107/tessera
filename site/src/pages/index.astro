---
// Landing v2. One idea per section, each carried by a real screenshot in a device or window frame.
// The HTML and CSS below are the complete static page (no JavaScript, or prefers-reduced-motion).
// src/scripts/landing.ts adds the scroll story on top: html.motion is set before first paint.
import { Image } from 'astro:assets';
import Landing from '../layouts/Landing.astro';
import Iphone from '../components/frames/Iphone.astro';
import Browser from '../components/frames/Browser.astro';
import { APP_URL, DEMO_CODE } from '../site.ts';
import world from '../assets/shots/studio-world-clay.png';
import camera from '../assets/shots/studio-cam-prod.png';
import photo from '../assets/shots/user-photo-d0481.jpg';
import drop from '../assets/shots/simple-drop-phone.png';
import found from '../assets/shots/simple-found-phone.png';
import yours from '../assets/shots/simple-yours-phone.png';
import there from '../assets/shots/simple-there-start-phone.png';
import simple from '../assets/shots/simple-prod-found-desktop.png';

const steps = [
  { img: drop, title: 'Drop a photo', alt: 'Simple on a phone: Where did they stand? with a drop zone for a photo' },
  { img: found, title: 'Found it', alt: 'Simple on a phone: Solid match, Manhattan Bridge from Washington St, facing 4 degrees N, lens 2.2x' },
  { img: yours, title: 'Make it yours', alt: 'Simple on a phone: the original photo beside an AI render with two people at golden hour' },
  { img: there, title: 'Take me there', alt: 'Simple on a phone: Walk to the mark, with Open camera and compass' },
];
const numbers = [
  { n: 10, suffix: '/11', label: 'held out photos placed' },
  { n: 3, suffix: '%', label: 'median focal error' },
  { n: 900, suffix: '/900', label: 'live edits committed' },
];
const tracks = [
  { name: 'NVIDIA', href: '/tracks/nvidia/' },
  { name: 'SpacetimeDB', href: '/tracks/spacetime/' },
  { name: 'Photon', href: '/tracks/photon/' },
  { name: 'Best Design', href: '/tracks/design/' },
  { name: 'Vultr', href: '/tracks/vultr/' },
];
// The solved camera's far plane in studio-world-clay.png (1512 x 982): corners measured from the screenshot.
const F = { x0: 647, y0: 322, x1: 819, y1: 549, cx: 732, cy: 491 };
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<Landing title="Tessera: stand where the photo was taken">
  <section class="hero" data-hero>
    <div class="hero-copy">
      <h1>Stand where the photo was taken.</h1>
      <p class="lede">Drop a photo. Tessera finds where the photographer stood, the heading and the lens.</p>
      <div class="ctas">
        <a class="btn primary" href={APP_URL}>Open the app</a>
        <a class="btn quiet" href="/tracks/">Tracks</a>
      </div>
    </div>
    <figure class="hero-stage">
      <Browser url={`app.tesseraphoto.com/studio/${DEMO_CODE}`}>
        <div class="h-zoom">
        <Image class="h-world" src={world} alt="Studio's 3D set of Washington St: clay buildings from NYC building footprints with the photo projected from where it was taken, two placed figures and the solved camera, Cam A." widths={[800, 1200, 1600]} sizes="(max-width: 900px) 100vw, 900px" loading="eager" fetchpriority="high" />
        <svg class="h-frustum" viewBox="0 0 1512 982" aria-hidden="true">
          {[[F.x0, F.y0], [F.x1, F.y0], [F.x1, F.y1], [F.x0, F.y1]].map(([x, y]) => <line class="ray" x1={F.cx} y1={F.cy} x2={x} y2={y} pathLength="1" />)}
          <rect class="plane" x={F.x0} y={F.y0} width={F.x1 - F.x0} height={F.y1 - F.y0} pathLength="1" />
        </svg>
        <div class="h-card" style={`left:${pct(F.x0, 1512)};top:${pct(F.y0, 982)};width:${pct(F.x1 - F.x0, 1512)};height:${pct(F.y1 - F.y0, 982)}`}>
          <Image src={photo} alt="The photo being located: the Manhattan Bridge framed by brick buildings on Washington St" widths={[400, 800]} sizes="(max-width: 900px) 60vw, 420px" loading="eager" />
        </div>
        <span class="chip readout" style={`left:${pct((F.x0 + F.x1) / 2, 1512)};top:${pct(F.y0, 982)}`}>4° N · 53 mm · Solid</span>
        <Image class="h-cam" src={camera} alt="Looking through Cam A in Studio: the user's photo as the backplate, two placed figures, focus on a person and the horizon marked in the margin" widths={[800, 1200, 1600]} sizes="(max-width: 900px) 100vw, 900px" loading="eager" />
        </div>
        <span class="chip card-chip">Your photo</span>
        <span class="chip cam-chip">Through Cam A</span>
      </Browser>
      <figcaption>Photo: <a href="https://commons.wikimedia.org/wiki/File:Manhattan_Bridge_-1.jpg">Shah Ronak S</a>, CC BY-SA 4.0</figcaption>
    </figure>
  </section>

  <section class="steps" data-steps aria-label="How it works, in four steps">
    <ol class="steps-list">
      {steps.map((s, i) => (
        <li class="step" data-step={i}>
          <div class="step-phone"><Iphone><Image src={s.img} alt={s.alt} widths={[400, 800]} sizes="(max-width: 760px) 70vw, 340px" /></Iphone></div>
          <p class="step-title"><span class="num">0{i + 1}</span>{s.title}</p>
        </li>
      ))}
    </ol>
    <div class="steps-rail" aria-hidden="true">{steps.map(() => <span />)}</div>
  </section>

  <section class="views" data-views>
    <div class="seg" role="group" aria-label="Show the view">
      <button type="button" class="seg-btn" aria-pressed="true" data-view="simple">Simple</button>
      <button type="button" class="seg-btn" aria-pressed="false" data-view="studio">Studio</button>
    </div>
    <p class="views-line">Same live set. Simple for friends, Studio for photographers.</p>
    <div class="views-stage">
      <Browser url={`app.tesseraphoto.com/p/${DEMO_CODE}`}>
        <Image class="v-simple" src={simple} alt="Simple on a laptop: the photo with placed figures beside the answer, facing 4 degrees N and 2.2x on your iPhone" widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1040px" />
        <Image class="v-studio" src={camera} alt="Studio on a laptop: the same set in the Darkroom editor, looking through Cam A with the scene outline and the camera inspector" widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1040px" />
      </Browser>
    </div>
  </section>

  <section class="numbers" data-numbers>
    <dl>
      {numbers.map((n) => (
        <div>
          <dt class="num"><span data-count={n.n}>{n.n}</span>{n.suffix}</dt>
          <dd>{n.label}</dd>
        </div>
      ))}
    </dl>
    <a class="more" href="/docs/why-tessera/#measured">How we measured</a>
  </section>

  <section class="tracks" aria-labelledby="tracks-h">
    <h2 id="tracks-h" class="label">Tracks</h2>
    <ul>{tracks.map((t) => <li><a href={t.href}>{t.name}</a></li>)}</ul>
  </section>

  <section class="final">
    <a class="btn primary big" href={`${APP_URL}/p/${DEMO_CODE}`}>Try the Manhattan Bridge shot</a>
  </section>
</Landing>

<script src="../scripts/landing.ts"></script>

<style is:global>
  /* Global on purpose: the selectors reach <img> elements rendered by astro:assets and the frame components. */
  section { padding-inline: 24px; }
  @media (max-width: 420px) { section { padding-inline: 16px; } }
  h1 { margin: 0; font-weight: 600; letter-spacing: -0.03em; text-wrap: balance; }
  .num { font-family: var(--mono); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border-radius: var(--r); font-weight: 600; font-size: 1rem; text-decoration: none; transition: background-color 0.2s ease, transform 0.16s var(--ease-out); }
  .btn:active { transform: scale(0.97); }
  .btn.primary { background: var(--amber); color: var(--amber-ink); }
  .btn.quiet { background: var(--raise); color: var(--text); }
  @media (hover: hover) and (pointer: fine) { .btn.primary:hover { background: #f5b65c; } .btn.quiet:hover { background: var(--field); } }
  .chip { position: absolute; z-index: 3; font-family: var(--mono); font-size: clamp(0.5625rem, 1vw, 0.75rem); line-height: 1; white-space: nowrap; color: var(--text); background: rgba(11, 11, 10, 0.88); border: 1px solid var(--line-2); border-radius: 4px; padding: 0.45em 0.6em; pointer-events: none; }

  /* Hero: copy beside the window on wide screens, above it on narrow ones. */
  .hero { min-height: calc(100svh - 56px); display: grid; grid-template-columns: minmax(260px, 340px) minmax(0, 1fr); gap: 40px; align-items: center; align-content: center; max-width: 1560px; margin: 0 auto; padding-block: 32px; }
  .hero h1 { font-size: 3rem; line-height: 1.05; }
  .lede { margin: 16px 0 0; font-size: 1.125rem; line-height: 1.6; color: var(--text-2); text-wrap: pretty; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero-stage { margin: 0; width: min(100%, calc((100svh - 176px) * 1.48)); justify-self: center; }
  .h-zoom { position: absolute; inset: 0; transform-origin: 48.48% 44.35%; }
  .hero-stage figcaption { margin-top: 8px; font-size: 0.75rem; color: var(--text-3); }
  .hero-stage figcaption a { color: inherit; }
  .h-world, .h-cam { position: absolute; inset: 0; }
  .h-cam { opacity: 0; }
  .h-frustum { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; overflow: visible; }
  .h-frustum line, .h-frustum rect { fill: none; stroke: var(--amber); stroke-width: 3; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .h-card { position: absolute; z-index: 1; border-radius: 3px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5); transform-origin: 50% 50%; }
  .h-card img { width: 100%; height: 100%; object-fit: cover; border-radius: 3px; }
  .card-chip { left: 50%; top: 12px; transform: translateX(-50%); opacity: 0; }
  .readout { transform: translate(-50%, calc(-100% - 10px)); }
  .cam-chip { left: 12px; top: 12px; opacity: 0; }

  /* Steps: four phones in a row when static; one pinned phone that changes screens with motion. */
  .steps { max-width: 1200px; margin: 96px auto 0; }
  .steps-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .step-phone { max-width: 280px; margin: 0 auto; }
  .step-title { margin: 16px 0 0; text-align: center; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.01em; }
  .step-title .num { display: block; font-size: 0.75rem; color: var(--amber); margin-bottom: 4px; }
  .steps-rail { display: none; }

  /* Simple and Studio: one window, two screenshots. Studio wipes in over Simple. */
  .views { max-width: 1088px; margin: 128px auto 0; text-align: center; }
  .seg { display: inline-flex; padding: 4px; gap: 4px; border-radius: 12px; background: var(--raise); }
  .seg-btn { min-height: 40px; padding: 8px 20px; border: 0; border-radius: 8px; background: transparent; color: var(--text-2); font: 600 0.875rem/1 var(--sans); cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease, transform 0.16s var(--ease-out); }
  .seg-btn[aria-pressed='true'] { background: var(--field); color: var(--text); box-shadow: 0 0 0 1px var(--line-2); }
  .seg-btn:active { transform: scale(0.97); }
  .views-line { margin: 16px auto 32px; color: var(--text-2); }
  .views-stage { text-align: left; }
  .v-simple, .v-studio { position: absolute; inset: 0; }
  .v-studio { clip-path: inset(0 0 0 100%); }
  .views[data-show='studio'] .v-studio { clip-path: inset(0 0 0 0); }

  /* Numbers. */
  .numbers { max-width: 1088px; margin: 128px auto 0; }
  .numbers dl { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .numbers dl > div { border-top: 1px solid var(--line-2); padding-top: 16px; }
  .numbers dt { font-size: 3.75rem; line-height: 1; color: var(--text); }
  .numbers dd { margin: 12px 0 0; color: var(--text-2); }
  .more { display: inline-block; margin-top: 32px; color: var(--text-2); font-size: 0.875rem; text-underline-offset: 0.2em; }
  .more:hover { color: var(--text); }

  /* Tracks as a strip of names. */
  .tracks { max-width: 1088px; margin: 128px auto 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px 40px; border-top: 1px solid var(--line); padding-top: 32px; }
  .label { margin: 0; font: 400 0.75rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); }
  .tracks ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 32px; }
  .tracks a { color: var(--text); text-decoration: none; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; text-decoration-color: var(--amber); text-underline-offset: 0.2em; }
  .tracks a:hover, .tracks a:focus-visible { text-decoration-line: underline; }

  .final { margin: 128px auto 128px; text-align: center; }
  .btn.big { min-height: 56px; padding: 12px 24px; font-size: 1.125rem; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 32px; min-height: auto; padding-block: 48px 32px; }
    .hero-stage { width: 100%; }
    /* On a phone the desktop screenshot is too small to read, so the window shows the 3D view around Cam A. */
    .h-zoom { transform: scale(1.6); }
    .hero h1 { font-size: 2.25rem; }
    .steps-list { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
    .numbers dl { grid-template-columns: 1fr; gap: 24px; }
    .numbers dt { font-size: 3rem; }
    .views, .numbers, .tracks { margin-top: 96px; }
  }

  /* Reduced motion: keep colour feedback, drop movement. Scroll motion is already off (html.motion is never set). */
  @media (prefers-reduced-motion: reduce) {
    .btn, .seg-btn { transition: background-color 0.2s ease, color 0.2s ease; }
    .btn:active, .seg-btn:active { transform: none; }
  }

  /* With motion: the hero starts with the photo held up in front of the set, and the steps stack into one phone. */
  html.motion .hero { min-height: calc(100svh - 56px); }
  html.motion .h-world { opacity: 0.35; }
  html.motion .h-card { transform: translate(13.4%, 24.4%) scale(3.5) rotate(-3deg); }
  @media (max-width: 900px) { html.motion .h-card { transform: translate(8.3%, 15.3%) scale(2.19) rotate(-3deg); } }
  html.motion .card-chip { opacity: 1; }
  html.motion .h-frustum line, html.motion .h-frustum rect { stroke-dashoffset: 1; }
  html.motion .readout { opacity: 0; }
  html.motion .steps { min-height: calc(100svh - 56px); max-width: 1040px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 48px; margin-top: 64px; }
  html.motion .steps-list { display: block; position: relative; height: min(76svh, 720px); }
  html.motion .step { position: absolute; inset: 0; display: grid; grid-template-columns: auto minmax(0, 400px); justify-content: center; align-items: center; gap: 80px; }
  html.motion .step + .step { opacity: 0; }
  html.motion .step-phone { height: 100%; width: auto; aspect-ratio: 433 / 882; max-width: none; margin: 0; }
  html.motion .step-title { text-align: left; font-size: 3rem; line-height: 1.05; letter-spacing: -0.03em; margin: 0; }
  html.motion .step-title .num { font-size: 0.875rem; margin-bottom: 12px; }
  html.motion .steps-rail { display: flex; flex-direction: column; gap: 8px; }
  html.motion .steps-rail span { width: 3px; height: 32px; border-radius: 2px; background: var(--line-2); }
  html.motion .steps-rail span.on { background: var(--amber); }
  @media (max-width: 900px) {
    html.motion .steps { grid-template-columns: 1fr; gap: 0; }
    html.motion .steps-list { height: min(78svh, 680px); }
    html.motion .step { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); gap: 16px; justify-items: center; }
    html.motion .step-title { order: -1; text-align: center; font-size: 1.875rem; }
    html.motion .step-phone { height: 100%; min-height: 0; }
    html.motion .steps-rail { display: none; }
  }
</style>
